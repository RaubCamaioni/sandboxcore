# Reference sandbox image: runs one Python tool per container with nothing but this package installed.
# It is what the integration tests run against, and the template for an app's own sandbox image:
# keep the uid (SandboxConfig.sandbox_uid), a python3 on PATH (the startup self-test runs
# `--entrypoint python3`) and an entrypoint that takes --file and --workdir.

FROM python:3.12-slim-bookworm

RUN useradd -u 1001 -m app && mkdir -p /venvs && chown app:app /venvs

USER app
COPY --chown=app:app pyproject.toml README.md /tmp/sandboxcore/
COPY --chown=app:app src /tmp/sandboxcore/src
RUN python3 -m venv /venvs/sandbox && \
  /venvs/sandbox/bin/pip install --no-cache-dir /tmp/sandboxcore && \
  rm -rf /tmp/sandboxcore

WORKDIR /box
ENTRYPOINT ["/venvs/sandbox/bin/sandboxcore-python"]
